import { cloneElement, isValidElement } from "react";

export default function Button({
  children,
  className = "",
  variant = "primary",
  asChild = false,
  ...props
}) {
  const styles = {
    primary: "bg-black text-white hover:-translate-y-1 hover:shadow-xl",
    secondary: "bg-white border border-neutral-300 text-black hover:bg-neutral-50",
  };

  const baseClasses = [
    "inline-flex",
    "items-center",
    "justify-center",
    "rounded-full",
    "px-8",
    "py-4",
    "font-medium",
    "transition-all",
    "duration-300",
    styles[variant],
    className,
  ]
    .filter(Boolean)
    .join(" ");

  if (asChild && isValidElement(children)) {
    return cloneElement(children, {
      ...props,
      className: [baseClasses, children.props.className].filter(Boolean).join(" "),
    });
  }

  return <button className={baseClasses} {...props}>{children}</button>;
}
